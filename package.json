{
  "name": "dash-firebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:hosting": "node --test tests/hosting.integration.mjs",
    "test:astryx": "node tests/astryx.browser.mjs",
    "test:rules": "firebase emulators:exec --project demo-dashfirebase --only database,auth \"node --test tests/rules.integration.mjs\"",
    "emulators": "firebase emulators:start --project demo-dashfirebase --only database,auth",
    "dev:local": "VITE_USE_FIREBASE_EMULATORS=true vite --host 127.0.0.1"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.12",
    "@astryxdesign/theme-neutral": "^0.7.12",
    "@stylexjs/stylex": "^0.19.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^15.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
