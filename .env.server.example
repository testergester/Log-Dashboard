# Copy to .env.server. Never use a VITE_ prefix for the DeepSeek key.
DEEPSEEK_API_KEY=
# Set this to the exact HTTPS origin when deploying behind a reverse proxy.
# Required for production start; no trailing slash.
APP_ORIGIN=https://your-dashboard.example
# Runtime project used to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=dashfirebase-9f0aa
# Hosting platforms usually provide PORT automatically.
# HOST=0.0.0.0
